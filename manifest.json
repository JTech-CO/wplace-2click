{
  "manifest_version": 3,
  "name": "wplace 2click",
  "version": "1.0.0",
  "description": "wplace.live에서 i 키를 누르면 현재 마우스 위치를 더블클릭합니다.",
  "icons": {
    "16": "icons/logo16.png",
    "48": "icons/logo48.png",
    "128": "icons/logo128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/logo16.png",
      "48": "icons/logo48.png",
      "128": "icons/logo128.png"
    },
    "default_title": "wplace 2click"
  },
  "content_scripts": [
    {
      "matches": [
        "https://wplace.live/*",
        "https://*.wplace.live/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
